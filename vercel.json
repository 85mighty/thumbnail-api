{
  "builds": [
    {"src": "api/thumbnail.py", "use": "@vercel/python"},
    {"src": "api/publish.py", "use": "@vercel/python"},
    {"src": "api/finalize.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/api/thumbnail", "dest": "api/thumbnail.py"},
    {"src": "/api/publish", "dest": "api/publish.py"},
    {"src": "/api/finalize", "dest": "api/finalize.py"}
  ],
  "functions": {
    "api/publish.py": {"maxDuration": 300},
    "api/finalize.py": {"maxDuration": 60}
  }
}
